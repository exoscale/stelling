{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": [
		"github>exoscale/github-actions:renovate-default.json"
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": [
				"/(^|/)Earthfile$/"
			],
			"matchStrings": [
				"GO_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
			],
			"depNameTemplate": "go",
			"datasourceTemplate": "golang-version"
		}
	]
}
