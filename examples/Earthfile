VERSION --try 0.8

ARG --global EXOSCALE_DOCKER_REGISTRY=registry.internal.exoscale.ch
ARG --global GO_VERSION=1.26.5

# --- Base images ---
source:
    FROM ${EXOSCALE_DOCKER_REGISTRY}/docker.io/library/golang:${GO_VERSION}-alpine
    WORKDIR /build
    RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
    RUN go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@latest
    COPY go.mod go.sum ./
    COPY . .

# --- Codegen ---

# Generates code from OpenAPI specs and updates local files
gen-oapi:
    FROM +source
    RUN oapi-codegen -config api/public/cfg.yaml api/public/api.yaml
    RUN oapi-codegen -config api/internal/cfg.yaml api/internal/api.yaml
    SAVE ARTIFACT api/public/api.gen.go AS LOCAL api/public/api.gen.go
    SAVE ARTIFACT api/internal/api.gen.go AS LOCAL api/internal/api.gen.go

# Generates code from protobuf spec and updates local files
gen-proto:
    FROM ${EXOSCALE_DOCKER_REGISTRY}/docker.io/bufbuild/buf:1
    WORKDIR /app
    COPY proto proto
    RUN buf generate proto --template proto/buf.gen.yaml -o proto
    SAVE ARTIFACT proto/schema.pb.go AS LOCAL proto/schema.pb.go
    SAVE ARTIFACT proto/schema_grpc.pb.go AS LOCAL proto/schema_grpc.pb.go

# Target to check for drift in generated files
drift:
    BUILD +gen-oapi
    BUILD +gen-proto

# --- Quality ---

# Formatting and lint fixes, applied to the local filesystem
format:
    FROM +source
    RUN golangci-lint fmt ./...
    RUN golangci-lint run --fix ./...
    RUN rm -rf ./.tmp-* # Remove temporary dirs
    SAVE ARTIFACT ./* AS LOCAL .

vulncheck:
    FROM +source
    RUN go install golang.org/x/vuln/cmd/govulncheck@latest
    RUN govulncheck ./...

buf-lint:
    FROM ${EXOSCALE_DOCKER_REGISTRY}/docker.io/bufbuild/buf:1
    WORKDIR /app
    COPY proto proto
    RUN buf lint proto

# --- Testing ---

test:
    FROM +source
    RUN go test ./...

# --- Image build and push ---

build:
    FROM +source
    ARG --required NAME
    # Inject standard stelling variable to expose versions as metrics
    LET revisionOpt="-X 'github.com/exoscale/stelling/fxmetrics.revision=${EARTHLY_GIT_HASH}'"
    LET revisionTimestampOpt="-X 'github.com/exoscale/stelling/fxmetrics.revisionTimestamp=${EARTHLY_GIT_COMMIT_TIMESTAMP}'"
    RUN CGO_ENABLED=0 go build -ldflags="${revisionOpt} ${revisionTimestampOpt}" -o /app/run ./cmd/${NAME}
    SAVE ARTIFACT /app/run


oci-image-build-jobs:
    FROM ${EXOSCALE_DOCKER_REGISTRY}/docker.io/library/alpine:3.24
    COPY (+build/run --NAME="job") /app/jobs
    USER 65534
    CMD ["/app/jobs"]
    ARG TAGS=dev
    FOR TAG IN $TAGS
	SAVE IMAGE --push ${EXOSCALE_DOCKER_REGISTRY}/exoscale/stelling-example/job:${TAG}
    END

oci-image-build-grpc-server:
    FROM ${EXOSCALE_DOCKER_REGISTRY}/docker.io/library/alpine:3.24
    COPY (+build/run --NAME="grpc-server") /app/grpc-server
    USER 65534
    CMD ["/app/grpc-server"]
    ARG TAGS=dev
    FOR TAG IN $TAGS
	SAVE IMAGE --push ${EXOSCALE_DOCKER_REGISTRY}/exoscale/stelling-example/grpc-server:${TAG}
    END

oci-image-build-http-server:
    FROM ${EXOSCALE_DOCKER_REGISTRY}/docker.io/library/alpine:3.24
    COPY (+build/run --NAME="http-server") /app/http-server
    USER 65534
    CMD ["/app/http-server"]
    ARG TAGS=dev
    FOR TAG IN $TAGS
	SAVE IMAGE --push ${EXOSCALE_DOCKER_REGISTRY}/exoscale/stelling-example/http-server:${TAG}
    END

oci-images:
    BUILD +oci-image-build-jobs
    BUILD +oci-image-build-http-server
    BUILD +oci-image-build-grpc-server


# --- CI pipeline ---

ci:
    BUILD +format
    BUILD +test
    BUILD +buf-lint
    BUILD +oci-images
