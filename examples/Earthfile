VERSION --try 0.8

ARG --global GO_VERSION=1.26.5
ARG --global TAG=dev

# Base image with source code
source:
    FROM library/golang:${GO_VERSION}-alpine

    WORKDIR /build
    COPY go.mod go.sum ./
    SAVE IMAGE --cache-hint

    COPY . .

# --- Codegen ---

# Generates code from OpenAPI specs and updates local files
gen-oapi:
    FROM +source
    RUN go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@latest
    RUN oapi-codegen -config api/public/cfg.yaml api/public/api.yaml
	RUN oapi-codegen -config api/internal/cfg.yaml api/internal/api.yaml
    SAVE ARTIFACT api/public/api.gen.go AS LOCAL api/public/api.gen.go
    SAVE ARTIFACT api/internal/api.gen.go AS LOCAL api/internal/api.gen.go

# Generates code from protobuf spec and updates local files
gen-proto:
    FROM bufbuild/buf:1
    WORKDIR /app
    COPY proto proto
	RUN buf generate proto --template proto/buf.gen.yaml -o proto
    SAVE ARTIFACT proto/schema.pb.go AS LOCAL proto/schema.pb.go
    SAVE ARTIFACT proto/schema_grpc.pb.go AS LOCAL proto/schema_grpc.pb.go

# --- Quality ---

format:
    FROM +source
    RUN test -z "$(gofmt -l . | grep -v '^vendor/')" || (gofmt -l . | grep -v '^vendor/' && exit 1)

lint:
    FROM +source
    RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.11.4
    RUN golangci-lint run ./...

vulncheck:
    FROM +source
    RUN go install golang.org/x/vuln/cmd/govulncheck@latest
    RUN govulncheck ./...

buf-lint:
    FROM bufbuild/buf:1
    WORKDIR /app
    COPY proto proto
	RUN buf lint proto

# --- Testing ---

test:
    FROM +source
    RUN go test ./...

# --- Image builds ---

build:
    FROM +source
    ARG --required NAME
    RUN CGO_ENABLED=0 go build -o /app/${NAME} ./cmd/${NAME}

    USER 65534
    CMD ["/app/${NAME}"]

grpc-server:
    FROM +build --NAME=grpc-server

http-server:
    FROM +build --NAME=http-server

job:
    FROM +build --NAME=job
