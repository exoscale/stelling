{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "customManagers:dockerfileVersions"
  ],
  "github-actions": {
    "enabled": false
  },
  "schedule": ["after 8am and before 5pm every weekday"],
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies",
    "HOLD :hand:",
    "triggered_by:renovate"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Generic regex manager for Renovate",
      "managerFilePatterns": [
        ".*"
      ],
      "matchStrings": [
        "renovate: datasource=(?<datasource>[a-z-]+)(?: depName=(?<depName>[^\\s]+))?.*\\n.*(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "renovate: datasource=github-tags(?: depName=(?<depName>[^\\s]+))?.*\\n\\s+.+github.com\\/.*ref=(?<currentValue>[a-z-]+?[a-f\\d]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Earthfile$/"
      ],
      "matchStrings": [
        "GO_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ]
}
